{
  "name": "mathbench-desktop",
  "version": "1.14.2",
  "license": "Apache-2.0",
  "description": "Mathbench: equation solver and graphing calculator with a hotkey screen capture for math problems",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.mathbench.desktop",
    "productName": "Mathbench",
    "files": [
      "main.js",
      "preload-main.js",
      "preload-overlay.js",
      "overlay.html",
      "assist.js",
      "helper.ps1",
      "settings.html",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
